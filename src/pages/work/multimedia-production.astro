---
import { multimediaPortfolio } from '../../data/multimedia-portfolio';
import DeferredYouTube from '../../components/DeferredYouTube.astro';
import LocalVideoCard from '../../components/LocalVideoCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import '../../styles/portfolio.css';
import '../../styles/multimedia-portfolio.css';
---

<BaseLayout
  title="Multimedia Production | Aaron Price"
  description={multimediaPortfolio.hero.support}
  themeColor="#f4f0e7"
  bodyClass="portfolio-home multimedia-portfolio"
  chrome={false}
>
  <header class="portfolio-header">
    <a class="portfolio-wordmark" href={withBase('/')} aria-label="Aaron Price, home">
      <span>AP</span>
      <span>Aaron Price</span>
    </a>
    <nav aria-label="Portfolio">
      <a href="#live-production">Live production</a>
      <a href="#educational-media">Educational media</a>
      <a href="#campaign-production">Campaign production</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <div id="top">
    <section class="hero multimedia-hero section-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">{multimediaPortfolio.hero.eyebrow}</p>
        <h1 id="hero-title">{multimediaPortfolio.hero.headline}</h1>
        <p class="hero-support">{multimediaPortfolio.hero.support}</p>
        <ul class="proof-list" aria-label="Production capabilities">
          {multimediaPortfolio.hero.proofs.map((proof) => <li>{proof}</li>)}
        </ul>
        <div class="hero-actions">
          <a class="button button-primary" href="#live-production">Explore live production <span aria-hidden="true">↘</span></a>
        </div>
      </div>
      <figure class="hero-still">
        <img src={withBase(multimediaPortfolio.liveProduction.media.poster)} alt="Concert-stage still from Coile Middle Holiday Concert 2024" decoding="async" />
        <figcaption><span>01 / Live production</span><span>Coile Middle Holiday Concert 2024</span></figcaption>
      </figure>
    </section>

    <section class="section-shell case-study-section case-study-section--dark" id="live-production" aria-labelledby="live-production-title">
      <article class="case-study">
        <p class="eyebrow">{multimediaPortfolio.liveProduction.eyebrow}</p>
        <h2 id="live-production-title">{multimediaPortfolio.liveProduction.title}</h2>
        <dl class="case-study-details">
          <div><dt>Production need</dt><dd>{multimediaPortfolio.liveProduction.need}</dd></div>
          <div><dt>Role</dt><dd>{multimediaPortfolio.liveProduction.role}</dd></div>
        </dl>
        <div class="case-study-featured">
          <DeferredYouTube media={multimediaPortfolio.liveProduction.media} featured />
          <div class="viewing-points">
            <h3>Suggested viewing points</h3>
            <ul>
              {multimediaPortfolio.liveProduction.viewingPoints.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        </div>
        <div class="case-study-grid">
          <div>
            <h3>Production decisions</h3>
            <ul>{multimediaPortfolio.liveProduction.decisions.map((decision) => <li>{decision}</li>)}</ul>
          </div>
          <div>
            <h3>Deliverables</h3>
            <ul>{multimediaPortfolio.liveProduction.deliverables.map((deliverable) => <li>{deliverable}</li>)}</ul>
          </div>
          <div>
            <h3>Tools / credits</h3>
            <p>{multimediaPortfolio.liveProduction.tools}</p>
          </div>
        </div>
      </article>
    </section>

    <section class="section-shell case-study-section case-study-section--light" id="educational-media" aria-labelledby="educational-media-title">
      <article class="case-study">
        <p class="eyebrow">{multimediaPortfolio.educationalMedia.eyebrow}</p>
        <h2 id="educational-media-title">{multimediaPortfolio.educationalMedia.title}</h2>
        <p class="case-study-summary">{multimediaPortfolio.educationalMedia.summary}</p>
        <dl class="case-study-details">
          <div><dt>Production need</dt><dd>{multimediaPortfolio.educationalMedia.need}</dd></div>
          <div><dt>Role</dt><dd>{multimediaPortfolio.educationalMedia.role}</dd></div>
        </dl>
        <div class="case-study-featured">
          <DeferredYouTube media={multimediaPortfolio.educationalMedia.media} featured />
        </div>
        <div class="case-study-grid">
          <div>
            <h3>Production decisions</h3>
            <ul>{multimediaPortfolio.educationalMedia.decisions.map((decision) => <li>{decision}</li>)}</ul>
          </div>
          <div>
            <h3>Deliverables</h3>
            <ul>{multimediaPortfolio.educationalMedia.deliverables.map((deliverable) => <li>{deliverable}</li>)}</ul>
          </div>
          <div>
            <h3>Tools / credits</h3>
            <p>{multimediaPortfolio.educationalMedia.tools}</p>
          </div>
        </div>
        <div class="supporting-media" aria-label="Supporting instructional videos">
          {multimediaPortfolio.educationalMedia.supportingMedia.map((media) => <DeferredYouTube media={media} />)}
        </div>
        <section class="visual-strip" aria-labelledby="visual-strip-title">
          <h3 id="visual-strip-title">Selected frames and curriculum visuals</h3>
          <div class="visual-strip__grid">
            {multimediaPortfolio.visualStorytelling.map((item) => (
              <figure>
                <img src={withBase(item.src)} alt={item.alt} loading="lazy" decoding="async" />
                <figcaption>{item.label}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      </article>
    </section>

    <section class="section-shell case-study-section case-study-section--blue" id="campaign-production" aria-labelledby="campaign-production-title">
      <article class="case-study">
        <p class="eyebrow">{multimediaPortfolio.campaignProduction.eyebrow}</p>
        <h2 id="campaign-production-title">{multimediaPortfolio.campaignProduction.title}</h2>
        <p class="case-study-summary">{multimediaPortfolio.campaignProduction.summary}</p>
        <dl class="case-study-details">
          <div><dt>Production need</dt><dd>{multimediaPortfolio.campaignProduction.need}</dd></div>
          <div><dt>Role</dt><dd>{multimediaPortfolio.campaignProduction.role}</dd></div>
        </dl>
        <div class="campaign-workflow" aria-label="Campaign workflow">
          {multimediaPortfolio.campaignProduction.workflow.map((step, index) => (
            <span>{step}{index < multimediaPortfolio.campaignProduction.workflow.length - 1 && <span aria-hidden="true"> → </span>}</span>
          ))}
        </div>
        <div class="campaign-feature">
          <figure>
            <img src={withBase(multimediaPortfolio.campaignProduction.contactSheet)} alt="Contact sheet showing the four Marching Tycoon campaign video covers" loading="lazy" decoding="async" />
            <figcaption>Four-piece campaign contact sheet</figcaption>
          </figure>
          <div class="campaign-grid" aria-label="Marching Tycoon campaign videos">
            {multimediaPortfolio.campaignProduction.media.map((media) => <LocalVideoCard media={media} />)}
          </div>
        </div>
        <div class="case-study-grid">
          <div>
            <h3>Production decisions</h3>
            <ul>{multimediaPortfolio.campaignProduction.decisions.map((decision) => <li>{decision}</li>)}</ul>
          </div>
          <div>
            <h3>Deliverables</h3>
            <ul>{multimediaPortfolio.campaignProduction.deliverables.map((deliverable) => <li>{deliverable}</li>)}</ul>
          </div>
          <div>
            <h3>Tools / credits</h3>
            <p>{multimediaPortfolio.campaignProduction.tools}</p>
          </div>
        </div>
      </article>
    </section>

    <section class="section-shell case-study-section case-study-section--creative" id="creative-work" aria-labelledby="creative-work-title">
      <article class="case-study creative-work">
        <p class="eyebrow">{multimediaPortfolio.creativeWork.eyebrow}</p>
        <h2 id="creative-work-title">{multimediaPortfolio.creativeWork.title}</h2>
        <p class="case-study-summary">{multimediaPortfolio.creativeWork.support}</p>
        <div class="supporting-media" aria-label="Selected creative videos">
          {multimediaPortfolio.creativeWork.media.map((media) => <DeferredYouTube media={media} />)}
        </div>
      </article>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="section-shell">
        <p class="eyebrow">Closing frame</p>
        <h2 id="contact-title">Let’s make the next story useful.</h2>
        <p>{multimediaPortfolio.closing}</p>
        <div class="contact-actions">
          <a href="mailto:hello@marchingtycoon.com">hello@marchingtycoon.com <span aria-hidden="true">↗</span></a>
          <a href={withBase('/')}>Back to the main portfolio <span aria-hidden="true">↖</span></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
