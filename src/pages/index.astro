---
import PortfolioProjectDetails from '../components/PortfolioProjectDetails.astro';
import { portfolioData } from '../data/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
import '../styles/portfolio.css';

const year = new Date().getFullYear();
const audioBars = Array.from({ length: 36 }, (_, index) => 22 + ((index * 37) % 78));
---

<BaseLayout
  title="Aaron Price | Educator, Digital Producer & Creative Technologist"
  description="Educational media, music technology, software, and digital publishing portfolio by Aaron Price."
  ogImage="/images/portfolio/portfolio-social-card.png"
  ogImageAlt="Aaron Price — educator, digital producer, and creative technologist"
  themeColor="#f4f0e7"
  bodyClass="portfolio-home"
  chrome={false}
>
  <header class="portfolio-header">
    <a class="portfolio-wordmark" href="#top" aria-label="Aaron Price, back to top">
      <span>AP</span>
      <span>Aaron Price</span>
    </a>
    <nav aria-label="Portfolio">
      <a href="#work">Work</a>
      <a href="#capabilities">Capabilities</a>
      <a href={withBase('/euclidean-rhythm-lab')}>Lab</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <div id="top">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Athens, Georgia · Working remotely</p>
        <h1 id="hero-title">{portfolioData.profile.headline}</h1>
        <p class="hero-lede">{portfolioData.profile.lede}</p>
        <p class="hero-support">{portfolioData.profile.support}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">
            View selected work <span aria-hidden="true">↓</span>
          </a>
          <a class="button button-secondary" href="mailto:hello@marchingtycoon.com">
            Start a conversation <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="hero-art" aria-label="Featured project: Music Tech Made Simple">
        <div class="hero-art-label">
          <span>Featured work</span>
          <span>01 / 05</span>
        </div>
        <div class="book-stage">
          <div class="book-shadow" aria-hidden="true"></div>
          <img
            src={withBase('/images/portfolio/music-tech-made-simple-cover.png')}
            alt="Cover of Music Tech Made Simple by Aaron Price"
            width="675"
            height="900"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="metrics" aria-label="Selected outcomes">
      <div class="metrics-grid section-shell">
        {
          portfolioData.metrics.map((metric) => (
            <div class="metric">
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="work section-shell" id="work" aria-labelledby="work-title">
      <div class="section-heading">
        <p class="eyebrow">Selected work</p>
        <h2 id="work-title">Ideas built all the way through.</h2>
        <p>Research, structure, production, revision, publishing—the whole arc.</p>
      </div>

      <article class="project project-featured">
        <div class="project-visual project-book">
          <img
            class="book-cover-small"
            src={withBase('/images/portfolio/music-tech-made-simple-cover.png')}
            alt="Music Tech Made Simple digital textbook cover"
            width="675"
            height="900"
            loading="lazy"
            decoding="async"
          />
          <a
            class="video-frame"
            href="https://www.youtube.com/watch?v=eJRE3znUYaA"
            target="_blank"
            rel="noreferrer"
            aria-label="Watch the Podcast Project walkthrough on YouTube"
          >
            <img
              src={withBase('/images/portfolio/podcast-walkthrough.avif')}
              alt="Podcast Project guided video walkthrough"
              width="336"
              height="188"
              loading="lazy"
              decoding="async"
            />
            <span class="play-button" aria-hidden="true">▶</span>
            <span class="video-caption">Podcast Project · 33:24</span>
          </a>
        </div>
        <PortfolioProjectDetails project={portfolioData.projects[0]} />
      </article>

      <div class="project-grid">
        <article class="project project-card">
          <div class="project-visual app-visual marching-visual">
            <img
              class="app-icon"
              src={withBase('/images/apps/marching-tycoon-icon.png')}
              alt="Marching Tycoon app icon"
              width="512"
              height="512"
              loading="lazy"
              decoding="async"
            />
            <img
              class="phone-shot"
              src={withBase('/images/apps/marching-tycoon-field-start.png')}
              alt="Marching Tycoon gameplay screen"
              width="640"
              height="1389"
              loading="lazy"
              decoding="async"
            />
          </div>
          <PortfolioProjectDetails project={portfolioData.projects[1]} />
        </article>

        <article class="project project-card">
          <div class="project-visual app-visual widgtext-visual">
            <div class="widget-word" aria-hidden="true">Make<br />words<br />work.</div>
            <img
              class="app-icon"
              src={withBase('/images/apps/widgtext-icon.png')}
              alt="WidgText app icon"
              width="512"
              height="512"
              loading="lazy"
              decoding="async"
            />
            <img
              class="phone-shot"
              src={withBase('/images/apps/widgtext-shot-1.jpg')}
              alt="WidgText widget customization screen"
              width="640"
              height="1390"
              loading="lazy"
              decoding="async"
            />
          </div>
          <PortfolioProjectDetails project={portfolioData.projects[2]} />
        </article>

        <article class="project project-card text-card live-card">
          <div class="project-visual audio-visual" aria-hidden="true">
            <div class="audio-lines">
              {audioBars.map((height) => <i style={`height: ${height}%`}></i>)}
            </div>
            <div class="audio-labels">
              <span>CAM A</span><span>CAM B</span><span>16 CH</span><span>48 kHz</span>
            </div>
          </div>
          <PortfolioProjectDetails project={portfolioData.projects[3]} />
        </article>

        <article class="project project-card text-card growth-card">
          <div
            class="project-visual growth-visual"
            aria-label="Program growth from 15 students to 150 to 200 annually"
          >
            <span class="growth-start">15</span>
            <div class="growth-line" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
            <span class="growth-end">150–200</span>
            <span class="growth-label">students / year</span>
          </div>
          <PortfolioProjectDetails project={portfolioData.projects[4]} />
        </article>
      </div>
    </section>

    <section class="capabilities" id="capabilities" aria-labelledby="capabilities-title">
      <div class="section-shell">
        <div class="section-heading light-heading">
          <p class="eyebrow">Capabilities</p>
          <h2 id="capabilities-title">The craft and the system.</h2>
          <p>
            I care about the quality of each asset—and the workflow that gets a whole project
            safely across the line.
          </p>
        </div>
        <div class="capability-list">
          {
            portfolioData.capabilities.map((capability) => (
              <div class="capability">
                <span class="cap-number">{capability.number}</span>
                <h3>{capability.title}</h3>
                <p>{capability.body}</p>
                <span class="cap-tools">{capability.tools}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="about section-shell" id="about" aria-labelledby="about-title">
      <div>
        <p class="eyebrow">About</p>
        <h2 id="about-title">Teaching is production work.</h2>
      </div>
      <div class="about-copy">
        <p class="about-lede">
          Six years of building a music technology program taught me to make complicated things
          feel usable.
        </p>
        <p>
          Every day has required audience insight, careful sequencing, clear feedback, deadline
          management, asset organization, and calm problem-solving. I have done that while
          producing original media, maintaining digital products, collaborating with colleagues,
          and supporting hundreds of learners.
        </p>
        <p>
          I am now bringing that same combination of editorial judgment, technical fluency, and
          learner empathy to digital production work.
        </p>
        <a class="lab-link" href={withBase('/euclidean-rhythm-lab')}>
          Explore the Euclidean Rhythm Lab learning sample <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="section-shell contact-grid">
        <p class="eyebrow">Let’s make something useful</p>
        <h2 id="contact-title">
          Looking for a producer who can understand the content and build the experience?
        </h2>
        <a class="contact-link" href="mailto:hello@marchingtycoon.com">
          hello@marchingtycoon.com <span aria-hidden="true">↗</span>
        </a>
        <div class="contact-meta">
          <span>Athens, Georgia</span>
          <span>Remote collaboration</span>
          <a href={withBase('/products')}>Product studio <span aria-hidden="true">↗</span></a>
          <a href={withBase('/blog')}>Writing <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </div>

  <footer class="portfolio-footer">
    <span>© {year} Aaron Price</span>
    <a href="#top">Back to top ↑</a>
  </footer>
</BaseLayout>
