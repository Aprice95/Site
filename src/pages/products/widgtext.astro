---
import ProductLayout from '../../layouts/ProductLayout.astro';
import { products } from '../../data/products';

const product = products.find((entry) => entry.slug === 'widgtext');
if (!product) {
  throw new Error('WidgText product data missing.');
}
---

<ProductLayout product={product}>
  <section class="section">
    <div class="container">
      <h2>Coming in WidgText 2.5</h2>
      <p>Seasonal collections bring new looks and words every few weeks. Preview Cozy Evenings now, then open its designs in WidgText 2.5 when the update is available.</p>
      <p>Share a widget image and collection link with a friend. Pro adds a personal library of named looks saved on your device. Free users can choose an optional rewarded ad to keep a featured look.</p>
      <a class="button button-primary" href="/products/widgtext/collections/">Explore the collections</a>
    </div>
  </section>
</ProductLayout>
