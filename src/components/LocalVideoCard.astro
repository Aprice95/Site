---
import type { LocalVideoMedia } from '../data/multimedia-portfolio';
import { withBase } from '../lib/paths';

interface Props { media: LocalVideoMedia; }
const { media } = Astro.props;
const mediaSlug = media.src.split('/').pop()?.replace(/\.mp4$/, '').replace(/[^a-z0-9]+/gi, '-') ?? 'video';
const titleId = `campaign-video-${mediaSlug}-title`;
---

<article class="campaign-card">
  <video aria-labelledby={titleId} controls preload="none" playsinline poster={withBase(media.poster)}>
    <source src={withBase(media.src)} type="video/mp4" />
    <p><a href={withBase(media.src)}>Open {media.title}</a></p>
  </video>
  <h3 id={titleId}>{media.title}</h3>
  <p>{media.accessibilityNote}</p>
</article>
